# ═══════════════════════════════════════════════════════════════
# BKP Digital — variabel lingkungan
# ═══════════════════════════════════════════════════════════════
#
# Catatan: autentikasi & database memakai Firebase. Konfigurasi web
# Firebase dibaca dari firebase-applet-config.json (bukan env var).
# Nilai di file itu aman untuk publik; yang melindungi data adalah
# Firebase Auth + firestore.rules.

# Pilih backend data (lihat docs/data-backend.md).
# local     = localStorage di peramban, tanpa server (default)
# firestore = Firebase Firestore + firestore.rules
VITE_DATA_BACKEND=local

# Port server produksi (server.js). Default 3000.
PORT=3000

# Opsional — belum dipakai runtime. src/lib/supabase.ts hanya diimpor
# untuk tipe data; aktifkan hanya jika benar-benar pindah ke Supabase.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Opsional — matikan hot reload saat menjalankan `vite` di lingkungan terbatas.
# DISABLE_HMR=false
