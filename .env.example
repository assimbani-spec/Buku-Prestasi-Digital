# ═══════════════════════════════════════════════════════════════
# BKP Digital: variabel lingkungan
# ═══════════════════════════════════════════════════════════════
#
# Catatan: autentikasi & database memakai Firebase. Konfigurasi web Firebase
# dibaca dari firebase-applet-config.json dan bisa ditimpa lewat env di bawah.
# Nilai di file itu aman untuk publik; yang melindungi data adalah Firebase
# Auth + firestore.rules. Build produksi dengan backend firestore menolak jalan
# bila masih memakai proyek contoh dan env VITE_FIREBASE_* belum diisi.

# Pilih backend data (lihat docs/data-backend.md).
# local     = localStorage di peramban, tanpa server (default)
# firestore = Firebase Firestore + firestore.rules
VITE_DATA_BACKEND=local

# Wajib untuk produksi Firestore: proyek milik sekolah, bukan proyek contoh.
# Salin dari Firebase Console > Project settings > Your apps > Web app.
# VITE_FIREBASE_PROJECT_ID=proyek-sekolah
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=proyek-sekolah.firebaseapp.com
# Opsional. Kosongkan untuk database "(default)".
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
# VITE_FIREBASE_STORAGE_BUCKET=proyek-sekolah.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# VITE_FIREBASE_MEASUREMENT_ID=

# Isi "demo" bila ingin data santri contoh di mode lokal. Biarkan kosong untuk
# memulai dari basis data kosong dengan satu akun admin.
# VITE_LOCAL_SEED=demo

# Port server produksi (server.js). Default 3000.
PORT=3000

# Opsional: matikan hot reload saat menjalankan `vite` di lingkungan terbatas.
# DISABLE_HMR=false
